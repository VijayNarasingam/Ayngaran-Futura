# Ayngaran Futura - environment
#
# Copy to `.env` for local use, or set these as Vercel environment variables.
# NEVER commit `.env` - it is git-ignored. Never paste keys into chat or code:
# DATABASE_URL contains the database password.

# ---------------------------------------------------------------------------
# PostgreSQL (used on Vercel, and anywhere else that has no persistent disk)
# ---------------------------------------------------------------------------
# Presence of this variable selects the Postgres driver. It takes precedence
# over everything below, so this is the only one Vercel needs.
#
# Neon console -> Connection Details -> "Pooled connection string" or
# "Direct connection string". The pooled one is the safer default.
#
# NOTE: with @neondatabase/serverless the driver talks to Neon over HTTPS, so
# either string works and no TCP connection is opened.

DATABASE_URL=postgresql://USER:PASSWORD@ep-EXAMPLE.us-east-2.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# Neon REST API (optional fallback - no extra dependency needed)
# ---------------------------------------------------------------------------
# Only used when DATABASE_URL is NOT set. PostgREST over plain fetch, which is
# how the app talked to Neon before the DATABASE_URL driver existed.
#
# NEON_REST_URL=https://ep-xxxxxxxx-xxxxxx.apirest.<region>.aws.neon.tech/<database>/rest/v1
# NEON_API_KEY=
# NEON_SCHEMA=public

# ---------------------------------------------------------------------------
# Local SQLite (the default when none of the above are set)
# ---------------------------------------------------------------------------
# PORT=8080
# SQLITE_PATH=server/ayngaran-futura.sqlite
# CORS_ORIGIN=https://your-vercel-domain.vercel.app