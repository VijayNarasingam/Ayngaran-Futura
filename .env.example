# Ayngaran Futura - environment
#
# Copy to `.env` for local use, or set these as Vercel environment variables.
# NEVER commit `.env` - it is git-ignored. Never paste keys into chat or code.

# ---------------------------------------------------------------------------
# Neon (required on Vercel, optional locally)
# ---------------------------------------------------------------------------
# Presence of BOTH of these switches storage from local SQLite to Neon.
# The app works with either - you do not need both configured at once.

# Neon REST API base URL (Neon console -> Connection Details -> REST API)
NEON_REST_URL=https://ep-xxxxxxxx-xxxxxx.apirest.<region>.aws.neon.tech/<database>/rest/v1

# Neon API key (Neon console -> Account Settings -> API Keys)
NEON_API_KEY=

# Postgres schema exposed through PostgREST. 'public' unless you changed it.
NEON_SCHEMA=public

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# PORT=8080
# SQLITE_PATH=server/ayngaran-futura.sqlite
# CORS_ORIGIN=https://your-vercel-domain.vercel.app